import streamlit as st
import PyPDF2
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
import re

# 1. Text Extraction Function
def extract_text_from_pdf(file):
    """Extracts raw text content from an uploaded PDF file."""
    pdf_reader = PyPDF2.PdfReader(file)
    text = ""
    for page in pdf_reader.pages:
        page_text = page.extract_text()
        if page_text:
            text += page_text + "\n"
    return text

# 2. Text Preprocessing Function
def clean_text(text):
    """Standardizes text data by lowering case and stripping non-alphanumeric noise."""
    text = text.lower()
    text = re.sub(r'[^a-z0-9\s]', '', text)  # Keep alphanumeric characters and spaces
    text = re.sub(r'\s+', ' ', text).strip() # Token space optimization
    return text

# 3. Keyword Gap Analysis Function
def analyze_keyword_gaps(resume_clean, jd_clean):
    """Finds words present in the Job Description but missing from the Resume."""
    resume_words = set(resume_clean.split())
    jd_words = set(jd_clean.split())
    
    # Simple stop-words list to keep recommendations meaningful
    stop_words = {'and', 'or', 'the', 'to', 'in', 'of', 'with', 'for', 'a', 'an', 'is', 'on', 'that', 'by', 'as', 'be', 'at'}
    
    missing_keywords = jd_words - resume_words - stop_words
    # Filter to display words longer than 2 characters (drops typos/artifacts)
    return [word for word in missing_keywords if len(word) > 2][:10]

# 4. Streamlit Application UI Configuration
st.set_page_config(page_title="Local AI Resume Analyzer", layout="wide")
st.title("🎯 Local ATS Resume Analyzer & Job Matcher")
st.caption("Developed for AIML Internship — 100% Privacy Focused ")

# Create layout columns
col1, col2 = st.columns(2)

with col1:
    st.subheader("📋 Step 1: Paste Job Description")
    job_description = st.text_area("Enter the target job profile requirements:", height=250)

with col2:
    st.subheader("📂 Step 2: Upload Resume")
    uploaded_file = st.file_uploader("Upload your resume in PDF format", type=["pdf"])

# 5. ML Processing Pipeline
if st.button("🚀 Analyze Match Score"):
    if uploaded_file is not None and job_description.strip() != "":
        with st.spinner("Processing local text embeddings..."):
            
            # Extract and Clean Text
            resume_text = extract_text_from_pdf(uploaded_file)
            
            cleaned_resume = clean_text(resume_text)
            cleaned_jd = clean_text(job_description)
            
            # Implement Vectorization & Cosine Similarity
            vectorizer = TfidfVectorizer()
            tfidf_matrix = vectorizer.fit_transform([cleaned_resume, cleaned_jd])
            
            # Compute match percentage
            match_percentage = cosine_similarity(tfidf_matrix[0:1], tfidf_matrix[1:2])[0][0] * 100
            
            # Extract insights
            missing_skills = analyze_keyword_gaps(cleaned_resume, cleaned_jd)
            
            # 6. UI Results Display
            st.success("Analysis Complete!")
            
            # Metric Callout Box
            st.metric(label="📊 Cumulative ATS Compatibility Score", value=f"{match_percentage:.2f}%")
            
            # Provide contextual feedback loops
            if match_percentage >= 70:
                st.balloons()
                st.info("💡 **Verdict:** Strong match! Your resume structure closely mirrors this job requirement.")
            elif match_percentage >= 40:
                st.warning("💡 **Verdict:** Moderate match. You possess foundational overlap, but look closely at optimization.")
            else:
                st.error("💡 **Verdict:** Low match alignment. Major adjustments to skill naming and details required.")
            
            # Display Keyword Gap Analysis
            st.subheader("🔍 Recommended Action Items (Missing Keywords/Skills)")
            if missing_skills:
                st.write("Incorporate these relevant contextual terms found in the job description to improve your score:")
                cols = st.columns(5)
                for index, word in enumerate(missing_skills):
                    cols[index % 5].markdown(f"`{word}`")
            else:
                st.write("Great job! No significant lexical gaps detected.")
                
    else:
        st.error("Please provide both a valid job description text and an uploaded PDF resume.")
